# Server
PORT=5000
NODE_ENV=development

# Frontend origin(s) allowed by CORS / CSRF check, comma-separated.
# The first one is used for links in emails (reset password).
CLIENT_URL=http://localhost:3000

# Number of reverse-proxy hops in front of the API (e.g. 1 behind Nginx).
# Leave empty when clients connect directly.
TRUST_PROXY=

# Auth cookie "Secure" flag. Empty = Secure only when NODE_ENV=production.
# Set to false when running production over plain http:// (e.g. Docker Compose
# on your machine). Leave empty once the site is served over HTTPS.
COOKIE_SECURE=

# Database
MONGO_URI=mongodb://127.0.0.1:27017/jobportal

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=30d
# Lifetime of the httpOnly auth cookie, in days (keep in sync with JWT_EXPIRE)
JWT_COOKIE_DAYS=30

# Email (SMTP). Leave SMTP_HOST empty in development: reset-password
# links are then printed to the server console instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_NAME=JobPortal
FROM_EMAIL=noreply@example.com
