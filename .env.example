# Biến cho docker-compose.yml. Copy thành .env (cùng thư mục) rồi sửa:
#   cp .env.example .env        # Windows: copy .env.example .env
# Không dùng khi chạy dev bằng npm run dev (khi đó dùng backend/.env).

# Cổng mở trên máy và địa chỉ người dùng gõ vào trình duyệt. Hai giá trị phải khớp nhau:
# backend chỉ nhận request ghi dữ liệu từ đúng APP_URL (chống CSRF) và dùng nó cho link trong email.
APP_PORT=8080
APP_URL=http://localhost:8080

# Bắt buộc, ít nhất 32 ký tự, không dùng giá trị mẫu. Tạo chuỗi ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=30d
JWT_COOKIE_DAYS=30

# false: cookie đăng nhập không có cờ Secure, để đăng nhập được qua http:// (chưa có HTTPS).
# Khi deploy có HTTPS thì để trống (cookie tự có Secure vì NODE_ENV=production).
COOKIE_SECURE=false

# Email. Để trống thì chức năng quên mật khẩu báo lỗi (production không in link ra log).
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_NAME=JobPortal
FROM_EMAIL=noreply@example.com
